# Define the courses list
courses = [ 'uli101', 'ops235', 'ops335', 'ops445', 'ops535', 'ops635' ]

# Perform a simple change to a list element
print(courses[0])  # Original item at index 0
courses[0] = 'eac150'  # Change the item at index 0
print(courses[0])  # New item at index 0
print(courses)  # Print the whole list after change

# Using built-in methods to manipulate the list

# Add a new item to the end of the list
courses.append('ops235')
print(courses)

# Add a new item to the specified index location
courses.insert(0, 'hwd101')  # Insert 'hwd101' at index 0, all other items shift
print(courses)

# Remove the first occurrence of a matching item from the list
courses.remove('ops335')
print(courses)

# Create a copy of the courses list and sort it
sorted_courses = courses.copy()
sorted_courses.sort()
print(courses)  # Original list remains unchanged
print(sorted_courses)  # Sorted copy of the list

# Working with numerical lists and getting useful information

list_of_numbers = [1, 5, 2, 6, 8, 5, 10, 2]

# Get the length of the list
length_of_list = len(list_of_numbers)

# Get the smallest value in the list
smallest_in_list = min(list_of_numbers)

# Get the largest value in the list
largest_in_list = max(list_of_numbers)

# Print the list information
print("List length is " + str(length_of_list) +
      ", smallest element in the list is " + str(smallest_in_list) +
      ", largest element in the list is " + str(largest_in_list))
